[Unit]
Description=CC-memory auto-capture supervisor
Documentation=file:%h/CC_project/CC-memory/docs/auto-capture-v0.5/memory-ops-cutover.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.ccm-project-url
ConditionPathExists=%h/.ccm-auto-capture-production-approved

[Service]
Type=oneshot
TimeoutStartSec=300
WorkingDirectory=%h/CC_project/CC-memory
Environment=CC_CAPTURE_LLM=codex-cli
Environment=CC_CAPTURE_LLM_FALLBACK=claude-cli
Environment=CC_CAPTURE_CODEX_MODEL=gpt-5.6-sol
Environment=CC_CAPTURE_CODEX_TIMEOUT_MS=90000
Environment=CC_CAPTURE_MAX_WINDOWS_PER_TICK=4
Environment=CC_CAPTURE_CLAUDE_MODEL=haiku
# codex 90 s + claude 75 s + 2×1 s killGrace + 15 s settle = 182 s reserve < tick 240 s < supervisor 270 s < TimeoutStartSec 300 s
Environment=CC_CAPTURE_CLAUDE_TIMEOUT_MS=75000
Environment=CC_CAPTURE_MAX_SESSIONS_PER_TICK=4
Environment=CC_MEMORY_PROJECT_URL_FILE=%h/.ccm-project-url
Environment=CC_MEMORY_ALERT_ENV_FILE=%h/.ccm-memory-alert.env
Environment=CC_MEMORY_ALERT_STATE_FILE=%h/.local/state/cc-memory/auto-capture-alert-state.json
Environment=CC_MEMORY_REQUIRE_ALERTS=1
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/bin/mkdir -p -m 700 %h/.cache/cc-memory
ExecStart=/usr/bin/flock -n -E 75 %h/.cache/cc-memory/auto-capture-run.lock /usr/bin/env node %h/CC_project/CC-memory/node_modules/tsx/dist/cli.mjs %h/CC_project/CC-memory/scripts/run-auto-capture-supervisor.ts
SuccessExitStatus=75
StandardOutput=journal
StandardError=journal
