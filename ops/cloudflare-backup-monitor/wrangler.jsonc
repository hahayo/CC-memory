{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cc-memory-backup-monitor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "cc-memory-backups"
    }
  ],
  "vars": {
    "CC_MEMORY_AGE_RECIPIENT": "age1t84j9vcpj2es3tnhrqmye945kjj9swqfaqyhdt5ulslnrcly0vrqhetl7f",
    "CC_BACKUP_MAX_AGE_HOURS": "26"
  }
}
