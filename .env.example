# CC-memory 環境變數設定範例
# 複製此檔案為 .env 並填入實際值

# PostgreSQL 連線字串 (必填)
# 格式: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:5432/cc_memory

# Embedding 設定 (可選 - 啟用語義搜尋)
# Gemini API 金鑰 - 從 https://aistudio.google.com/apikey 取得
GEMINI_API_KEY=your_gemini_api_key

# Embedding 模型 (預設: gemini-embedding-001)
# EMBEDDING_MODEL=gemini-embedding-001

# Embedding 維度 (預設: 1536)
# EMBEDDING_DIMENSIONS=1536
